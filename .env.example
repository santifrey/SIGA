# ========================================================
# SIGA - Variables de Entorno (Archivo de Ejemplo)
# ========================================================
# Copia este archivo a '.env' y completa con tus credenciales reales:
# cp .env.example .env
#
# IMPORTANTE: El archivo '.env' está ignorado por git para proteger credenciales.
# ========================================================

# Base de Datos
# UseSqlite: 'false' para conectar a MySQL, 'true' para desarrollo rápido con SQLite local
USE_SQLITE=false

# Opción A: Parámetros individuales de MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=siga_db
DB_USER=root
DB_PASSWORD=root

# Opción B: Cadena de conexión completa (si se define, tiene prioridad sobre los parámetros individuales)
# MYSQL_CONNECTION_STRING=Server=localhost;Port=3306;Database=siga_db;User=root;Password=root;

# Seguridad y Autenticación JWT
JWT_SECRET_KEY=SIGA_Local_Development_Only_Secret_Key_2026_Azafran_Mediterraneo!
JWT_ISSUER=SIGA.API
JWT_AUDIENCE=SIGA.Frontend
JWT_EXPIRATION_HOURS=24

# Puerto HTTP del servidor (opcional, útil para despliegue en Google Cloud Run / contenedores)
# PORT=5000

